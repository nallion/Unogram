<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3" IgnorableNamespaces="uap mp uap3">
  <!-- Publisher must match the CN of the signing certificate (see AutoSignAppx in the .csproj) -->
  <Identity Name="Unogram" Publisher="CN=DevUser" Version="1.1.0.23" ProcessorArchitecture="arm" />
  <mp:PhoneIdentity PhoneProductId="8f3d1c62-4a7e-4b19-9c05-2ed6a4f7b310" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Unogram</DisplayName>
    <PublisherDisplayName>Test</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <!-- Windows.Mobile restricts installation to phones only (no desktop / HoloLens / Xbox).
         MinVersion 10.0.10240.0 covers every Windows 10 Mobile release from 1507 on.
         It must stay <= 10.0.15254.0 or nothing installs. -->
    <TargetDeviceFamily Name="Windows.Mobile" MinVersion="10.0.10240.0" MaxVersionTested="10.0.15063.0" />
    <!-- Required by libtgvoip.dll, which imports MSVCP140_APP.dll,
         VCRUNTIME140_APP.dll and vccorlib140_app.dll. Declared by hand rather
         than through an SDKReference: the VCLibs extension SDK on a modern build
         machine declares MinVersion 14.0.33519.0 and ships no ARM32 payload, so
         an SDKReference would demand a runtime the phone can never have.
         14.0.22929.0 is the first 14.0 release, so any VCLibs the device carries
         satisfies it; the device supplies it and nothing ships in the package. -->
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.22929.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="Unogram.exe" EntryPoint="TelegramWP10.App">
      <uap:VisualElements DisplayName="Unogram" Description="Unogram" BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile ShortName="Unogram" Wide310x150Logo="Assets\Wide310x150Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#000000" />
        <!-- badgeAndTileText, not badge: "badge" only qualifies the app for the
             lock screen quick-status slots. Detailed status ("Choose an app to
             show detailed status") lists only apps declaring badgeAndTileText,
             and it renders the text of the wide tile binding, so the app must
             also have a Wide310x150Logo - it does, and both tile writers emit a
             TileWide binding (MainPage.BuildTileXml, CatchUpTask.ApplyTileXml). -->
        <uap:LockScreen Notification="badgeAndTileText" BadgeLogo="Assets\Square24x24Logo.png" />
      </uap:VisualElements>
      <!-- Catch-up background task. Out-of-process: the background task host
           activates it on a TimeTrigger without loading the XAML app, so the
           whole memory budget goes to TDLib.
           EntryPoint must match TaskEntryPoint in
           BackgroundService.RegisterCatchUpTaskAsync and the full type name in
           UnogramBackground/CatchUpTask.cs. Without this declaration the winmd
           is not packaged and the task never activates at all. -->
      <Extensions>
        <Extension Category="windows.backgroundTasks" EntryPoint="UnogramBackground.CatchUpTask">
          <BackgroundTasks>
            <Task Type="timer" />
          </BackgroundTasks>
        </Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <uap:Capability Name="picturesLibrary" />
    <uap:Capability Name="videosLibrary" />
    <uap:Capability Name="musicLibrary" />
    <uap3:Capability Name="backgroundMediaPlayback" />
    <!-- Needed only for ExtendedExecutionReason.LocationTracking: it is the
         one extended-execution mode that keeps working on Windows 10 Mobile
         with the screen locked. No position is ever read or transmitted. -->
    <DeviceCapability Name="location" />
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>